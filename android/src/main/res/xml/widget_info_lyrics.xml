<?xml version="1.0" encoding="utf-8"?>
<!-- Redimension libre: el launcher deja estirarlo en horizontal y en
     vertical. El bloque de la letra se queda el espacio que sobre (weight),
     asi que cuanto mas alto, mas sitio para la letra. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="60dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_lyrics"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
