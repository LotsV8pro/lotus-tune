<?xml version="1.0" encoding="utf-8"?>
<!-- Redimension libre: el launcher deja estirarlo en horizontal y en
     vertical. El bloque de la letra se queda el espacio que sobre (weight),
     asi que cuanto mas alto, mas sitio para la letra.
     El minimo tiene que dar para cabecera + barra + controles + la letra:
     con 60dp el launcher lo dejaba añadir a dos filas y solo se veia la
     cabecera (la letra quedaba recortada y parecia que el widget no iba). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="110dp"
    android:minResizeHeight="150dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_lyrics"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
