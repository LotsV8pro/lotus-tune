<?xml version="1.0" encoding="utf-8"?>
<!-- Redimension libre. Solo lleva la letra (anterior, actual y siguiente), asi
     que el minimo es mas bajo que el del reproductor: con 110dp de alto caben
     las tres lineas y el sitio para estirarlo hacia abajo se lo queda la
     letra (weight en el bloque). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_lyrics"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
