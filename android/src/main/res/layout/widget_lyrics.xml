<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de LETRA: solo la letra (anterior, actual y siguiente), sin
     cabecera, sin barra y sin botones. Un widget no puede desenfocar lo que
     tiene detras (RemoteViews no llega al fondo de pantalla), asi que el
     "cristal" es un velo blanco muy fino: se ve el fondo entero, solo un poco
     mas claro, y la letra oscura se lee por el halo blanco.
     La linea activa va en una sola capa: se enciende entera y entra con un
     fundido corto cuando cambia. El barrido palabra a palabra no cabe aqui:
     cada fotograma obliga al launcher a medir y trazar el texto otra vez, y
     MIUI no pasa de 16 o 20 por segundo (la app va a 60). El texto y el tamano
     de cada fila los pone LyricsWidget al vuelo.
     Tocar la letra abre la app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/l_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/l_prev_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="#5711141A"
            android:textSize="13sp"
            android:shadowColor="#66FFFFFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/l_rowA0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:maxLines="1"
                android:ellipsize="none"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="#F011141A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:shadowColor="#99FFFFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:text="" />

            <TextView
                android:id="@+id/l_rowA1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:maxLines="1"
                android:ellipsize="none"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="#F011141A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:shadowColor="#99FFFFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:text="" />
        </LinearLayout>

        <TextView
            android:id="@+id/l_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="#8C11141A"
            android:textSize="14sp"
            android:shadowColor="#66FFFFFF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:text=" " />
    </LinearLayout>
</FrameLayout>
