<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de LETRA: solo la letra (anterior, actual y siguiente), sin
     cabecera, sin barra y sin botones. Un widget no puede desenfocar lo que
     tiene detras (RemoteViews no llega al fondo de pantalla), asi que el
     "cristal" es una tarjeta translucida: se ve el fondo por debajo, sin
     difuminar.
     Dos copias identicas dentro de un ViewFlipper: al cambiar de linea se
     enseña la otra copia con un fundido + deslizamiento (solo cuando
     cambia, no en cada repintado del karaoke).
     Tocar la letra abre la app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/l_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <ViewFlipper
        android:id="@+id/l_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inAnimation="@anim/lw_line_in"
        android:animateFirstView="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/l_prev_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="#66FFFFFF"
                android:textSize="13sp"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="9"
                android:text="" />

            <TextView
                android:id="@+id/l_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:maxLines="4"
                android:lineSpacingExtra="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:shadowColor="#FF000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="14"
                android:text="" />

            <TextView
                android:id="@+id/l_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="#99FFFFFF"
                android:textSize="14sp"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="9"
                android:text=" " />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/l_prev_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="#66FFFFFF"
                android:textSize="13sp"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="9"
                android:text="" />

            <TextView
                android:id="@+id/l_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:maxLines="4"
                android:lineSpacingExtra="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:shadowColor="#FF000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="14"
                android:text="" />

            <TextView
                android:id="@+id/l_next2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="#99FFFFFF"
                android:textSize="14sp"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="9"
                android:text=" " />
        </LinearLayout>
    </ViewFlipper>
</FrameLayout>
