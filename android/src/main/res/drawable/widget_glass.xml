<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget de letra: cristal empañado, no una caja oscura. Un
     RemoteViews no puede desenfocar el fondo de pantalla (lo pinta el launcher
     por debajo), asi que el "vaho" se hace con un velo blanco a media
     opacidad: el fondo se intuye detras, como a traves de un cristal
     empañado, y la letra oscura se lee encima.
     Borde blanco fino y esquinas de 22dp para que se lea como una tarjeta. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#8CFFFFFF"
        android:endColor="#73FFFFFF" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#B3FFFFFF" />
</shape>
