<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget de letra: casi nada. Un RemoteViews no puede desenfocar
     el fondo de pantalla (lo pinta el launcher por debajo), asi que un velo
     muy fino de blanco hace de cristal: el fondo se ve entero, solo un poco
     mas claro, y la letra oscura se lee gracias al halo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#33FFFFFF"
        android:endColor="#4DFFFFFF" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#66FFFFFF" />
</shape>
