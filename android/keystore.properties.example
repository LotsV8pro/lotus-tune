# Copia este fichero a android/keystore.properties (o a
# build-android/android-build/keystore.properties) y rellena los valores.
# Sin este fichero la APK se firma con la clave de debug.
#
# Aviso: la primera build firmada con una clave distinta de la de debug
# NO se puede instalar encima de la anterior: hay que desinstalar una vez
# (se pierde la biblioteca que este dentro del sandbox de la app).
storeFile=/ruta/a/lotus-tune-release.jks
storePassword=CAMBIAME
keyAlias=lotus-tune
keyPassword=CAMBIAME
