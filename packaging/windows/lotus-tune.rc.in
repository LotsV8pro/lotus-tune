#include <windows.h>

// Icon of the .exe and of the shortcuts the installer creates.
IDI_ICON1 ICON "@LOTUS_WIN_ICON@"

// Version shown by the properties of the .exe (and by the installer).
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @LOTUS_WIN_FILEVERSION@
 PRODUCTVERSION @LOTUS_WIN_FILEVERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LotusTune"
            VALUE "FileDescription", "LotusTune"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "lotus-tune"
            VALUE "LegalCopyright", "LotusTune"
            VALUE "OriginalFilename", "lotus-tune.exe"
            VALUE "ProductName", "LotusTune"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
